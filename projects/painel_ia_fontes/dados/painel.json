e":"DS_TIPO_CONVENIO","allParam":"convtipos_todos","title":"Atendimento.Tipo Convênio","operator":9,"param":"convtipos"},{"completeName":"DS_CARATER_ATENDIMENTO","allParam":"carater_todos","title":"Atendimento.Caráter/Clínica","operator":9,"param":"carater"},{"completeName":"DS_SEXO","allParam":"sexos_todos","title":"Paciente.Sexo","operator":9,"param":"sexos"}],"description":"Atendimentos por tipo de atendimento.","dimensions":[{"completeName":"DS_TP_ATENDIMENTO","title":"Atendimento.Tipo Atendimento"}]},{"metadataTitle":"Exemplos - Atendimentos Geral - Atendimentos em geral","rowsLimit":5000,"name":"por_carater","title":"Por caráter/clínica","metadataId":28,"measures":[{"completeName":"MD_QT_TOTAL_ATENDIMENTO","title":"Atendimento.Qt Total Atendimento"},{"completeName":"MD_QT_MEDIA_DIAS_PERMANENCIA","title":"Atendimento.Qt Média de Permanência em Dias"}],"paramFilters":[{"completeName":"DT_ATENDIMENTO_yearMonth","title":"Atendimento.Data.Mês/ano","operator":10,"param":"periodo"},{"completeName":"DS_TP_ATENDIMENTO","allParam":"tipos_todos","title":"Atendimento.Tipo Atendimento","operator":9,"param":"tipos"},{"completeName":"DS_TIPO_CONVENIO","allParam":"convtipos_todos","title":"Atendimento.Tipo Convênio","operator":9,"param":"convtipos"},{"completeName":"DS_CARATER_ATENDIMENTO","allParam":"carater_todos","title":"Atendimento.Caráter/Clínica","operator":9,"param":"carater"},{"completeName":"DS_SEXO","allParam":"sexos_todos","title":"Paciente.Sexo","operator":9,"param":"sexos"}],"description":"Atendimentos e permanência média por caráter/clínica.","dimensions":[{"completeName":"DS_CARATER_ATENDIMENTO","title":"Atendimento.Caráter/Clínica"}]},{"metadataTitle":"Exemplos - Atendimentos Geral - Atendimentos em geral","rowsLimit":5000,"name":"por_convtipo","title":"Por tipo de convênio","metadataId":28,"measures":[{"completeName":"MD_QT_TOTAL_ATENDIMENTO","title":"Atendimento.Qt Total Atendimento"}],"paramFilters":[{"completeName":"DT_ATENDIMENTO_yearMonth","title":"Atendimento.Data.Mês/ano","operator":10,"param":"periodo"},{"completeName":"DS_TP_ATENDIMENTO","allParam":"tipos_todos","title":"Atendimento.Tipo Atendimento","operator":9,"param":"tipos"},{"completeName":"DS_TIPO_CONVENIO","allParam":"convtipos_todos","title":"Atendimento.Tipo Convênio","operator":9,"param":"convtipos"},{"completeName":"DS_CARATER_ATENDIMENTO","allParam":"carater_todos","title":"Atendimento.Caráter/Clínica","operator":9,"param":"carater"},{"completeName":"DS_SEXO","allParam":"sexos_todos","title":"Paciente.Sexo","operator":9,"param":"sexos"}],"description":"Atendimentos por tipo de convênio.","dimensions":[{"completeName":"DS_TIPO_CONVENIO","title":"Atendimento.Tipo Convênio"}]},{"metadataTitle":"Exemplos - Atendimentos Geral - Atendimentos em geral","rowsLimit":5000,"name":"piramide","title":"Pirâmide etária","metadataId":28,"measures":[{"completeName":"MD_QT_TOTAL_ATENDIMENTO","title":"Atendimento.Qt Total Atendimento"}],"paramFilters":[{"completeName":"DT_ATENDIMENTO_yearMonth","title":"Atendimento.Data.Mês/ano","operator":10,"param":"periodo"},{"completeName":"DS_TP_ATENDIMENTO","allParam":"tipos_todos","title":"Atendimento.Tipo Atendimento","operator":9,"param":"tipos"},{"completeName":"DS_TIPO_CONVENIO","allParam":"convtipos_todos","title":"Atendimento.Tipo Convênio","operator":9,"param":"convtipos"},{"completeName":"DS_CARATER_ATENDIMENTO","allParam":"carater_todos","title":"Atendimento.Caráter/Clínica","operator":9,"param":"carater"},{"completeName":"DS_SEXO","allParam":"sexos_todos","title":"Paciente.Sexo","operator":9,"param":"sexos"}],"description":"Atendimentos por faixa etária ANS e sexo.","dimensions":[{"completeName":"DS_FAIXA_ETARIA_ANS","title":"Paciente.Idade.Faixa Etária ANS"},{"completeName":"DS_SEXO","title":"Paciente.Sexo"}]},{"metadataTitle":"Exemplos - Atendimentos Geral - Atendimentos em geral","rowsLimit":15,"name":"top_conv","title":"Ranking de convênios","metadataId":28,"measures":[{"completeName":"MD_QT_TOTAL_ATENDIMENTO","title":"Atendimento.Qt Total Atendimento"},{"completeName":"MD_QT_PACIENTE","title":"Paciente.Qt Pacientes"},{"completeName":"MD_QT_MEDIA_DIAS_PERMANENCIA","title":"Atendimento.Qt Média de Permanência em Dias"}],"paramFilters":[{"completeName":"DT_ATENDIMENTO_yearMonth","title":"Atendimento.Data.Mês/ano","operator":10,"param":"periodo"},{"completeName":"DS_TP_ATENDIMENTO","allParam":"tipos_todos","title":"Atendimento.Tipo Atendimento","operator":9,"param":"tipos"},{"completeName":"DS_TIPO_CONVENIO","allParam":"convtipos_todos","title":"Atendimento.Tipo Convênio","operator":9,"param":"convtipos"},{"completeName":"DS_CARATER_ATENDIMENTO","allParam":"carater_todos","title":"Atendimento.Caráter/Clínica","operator":9,"param":"carater"},{"completeName":"DS_SEXO","allParam":"sexos_todos","title":"Paciente.Sexo","operator":9,"param":"sexos"}],"description":"Os 15 convênios com mais atendimentos, com pacientes e permanência média.","dimensions":[{"completeName":"NO_CONVENIO","title":"Atendimento.Convênio"}]}],"html":"<!doctype html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\">\n<script src=\"wk-lib:chartjs\"></script>\n<style>\n:root{--fundo:#f4f6f9;--cartao:#ffffff;--texto:#16202e;--suave:#64748b;--borda:#e2e8f0;--d1:#0e7490;--d2:#f59e0b;--d3:#7c3aed;--fem:#db2777;--mas:#2563eb;--chip:#e0f2fe}\n@media (prefers-color-scheme: dark){:root{--fundo:#0f172a;--cartao:#1e293b;--texto:#f1f5f9;--suave:#94a3b8;--borda:#334155;--d1:#22d3ee;--d2:#fbbf24;--d3:#a78bfa;--fem:#f472b6;--mas:#60a5fa;--chip:#164e63}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--fundo);color:var(--texto);font:14px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nh1{font-size:22px;margin:0 0 2px}\n.sub{color:var(--suave);margin:0 0 16px}\n.cartao{background:var(--cartao);border:1px solid var(--borda);border-radius:12px;padding:16px;position:relative}\n.filtros{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));margin-bottom:16px}\n.ftit{font:600 11px system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase;color:var(--suave);margin-bottom:6px}\n.chips button{margin:0 4px 4px 0;padding:3px 10px;border:1px solid var(--borda);border-radius:999px;background:transparent;color:var(--texto);cursor:pointer;font:12px system-ui,sans-serif}\n.chips button[aria-pressed=\"true\"]{background:var(--d1);border-color:var(--d1);color:var(--cartao)}\n.periodo select{padding:4px 6px;border:1px solid var(--borda);border-radius:6px;background:var(--cartao);color:var(--texto)}\n.acoes{display:flex;justify-content:flex-end;margin:-6px 0 12px}\n.acoes button{border:1px solid var(--borda);background:var(--cartao);color:var(--texto);border-radius:6px;padding:5px 12px;cursor:pointer}\n.kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:16px}\n.kpi .rot{color:var(--suave);font:600 11px system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase}\n.kpi .val{display:block;font-size:30px;font-weight:700;color:var(--d1);margin-top:4px;min-height:40px}\n.kpi .uni{color:var(--suave);font-size:12px}\n.grade{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));margin-bottom:16px}\n.larga{grid-column:1/-1}\n.cartao h2{font-size:15px;margin:0 0 10px}\n.graf{position:relative;height:300px}\n.graf.alto{height:360px}\n.msg{color:var(--suave);font-size:13px;min-height:0}\n.msg:empty{display:none}\ntable{width:100%;border-collapse:collapse;font-size:13px}\nth,td{padding:6px 8px;border-bottom:1px solid var(--borda);text-align:right;white-space:nowrap}\nth:first-child,td:first-child{text-align:left}\nth{color:var(--suave);font-weight:600;font-size:12px}\n.barra{display:inline-block;height:8px;border-radius:4px;background:var(--d1);vertical-align:middle;margin-right:6px;opacity:.7}\n.tabwrap{overflow-x:auto}\n[data-dash-source-state=\"loading\"],[data-dash-source-state=\"refreshing\"]{opacity:.55;transition:opacity .2s}\n[data-dash-source-state=\"error\"]{outline:1px dashed #dc2626}\n</style></head>\n<body>\n<h1>Atendimentos em geral — painel analítico</h1>\n<p class=\"sub\" id=\"subtitulo\">Metadado 28 · Exemplos - Atendimentos Geral</p>\n\n<div class=\"filtros\">\n  <div class=\"cartao periodo\" data-source=\"opt_meses\" data-fetchpriority=\"high\">\n    <div class=\"ftit\">Período (mês/ano)</div>\n    <select id=\"ini\" aria-label=\"Mês inicial\"></select> até <select id=\"fim\" aria-label=\"Mês final\"></select>\n  </div>\n  <div class=\"cartao\"><div class=\"ftit\">Tipo de atendimento</div><div class=\"chips\" id=\"f-tipos\" data-source=\"opt_tipos\" data-fetchpriority=\"high\"></div></div>\n  <div class=\"cartao\"><div class=\"ftit\">Tipo de convênio</div><div class=\"chips\" id=\"f-conv\" data-source=\"opt_conv\" data-fetchpriority=\"high\"></div></div>\n  <div class=\"cartao\"><div class=\"ftit\">Caráter / Clínica</div><div class=\"chips\" id=\"f-carater\" data-source=\"opt_carater\"></div></div>\n  <div class=\"cartao\"><div class=\"ftit\">Sexo</div><div class=\"chips\" id=\"f-sexo\" data-source=\"opt_sexo\"></div></div>\n</div>\n<div class=\"acoes\"><button id=\"limpar\" type=\"button\">Limpar filtros</button></div>\n\n<div class=\"kpis\">\n  <div class=\"cartao kpi\"><span class=\"rot\">Atendimentos</span><span class=\"val\" id=\"k-atend\" data-source=\"kpis\" data-field=\"MD_QT_TOTAL_ATENDIMENTO\" data-row=\"0\" data-fetchpriority=\"high\"></span></div>\n  <div class=\"cartao kpi\"><span class=\"rot\">Pacientes</span><span class=\"val\" id=\"k-pac\" data-source=\"kpis\" data-field=\"MD_QT_PACIENTE\" data-row=\"0\"></span></div>\n  <div class=\"cartao kpi\"><span class=\"rot\">Atendimentos por paciente</span><span class=\"val\" id=\"k-razao\" data-source=\"resumo\" data-field=\"ATEND_POR_PACIENTE\" data-row=\"0\"></span></div>\n  <div class=\"cartao kpi\"><span class=\"rot\">Permanência média</span><span class=\"val\" id=\"k-perm\" data-source=\"kpis\" data-field=\"MD_QT_MEDIA_DIAS_PERMANENCIA\" data-row=\"0\"></span><span class=\"uni\">dias</span></div>\n  <div class=\"cartao kpi\"><span class=\"rot\">Idade média</span><span class=\"val\" id=\"k-idade\" data-source=\"kpis\" data-field=\"MD_QT_IDADE_MEDIA\" data-row=\"0\"></span><span class=\"uni\">anos</span></div>\n</div>\n<div class=\"msg\" id=\"m-kpis\"></div>\n\n<div class=\"grade\">\n  <div class=\"cartao larga\"><h2>Tendência mensal</h2><div class=\"msg\" id=\"m-tend\"></div>\n    <div class=\"graf\" data-source=\"tendencia\"><canvas id=\"g-tend\"></canvas></div></div>\n  <div class=\"cartao\"><h2>Por tipo de atendimento</h2><div class=\"msg\" id=\"m-tipo\"></div>\n    <div class=\"graf\" data-source=\"tipo_share\"><canvas id=\"g-tipo\"></canvas></div></div>\n  <div class=\"cartao\"><h2>Por tipo de convênio</h2><div class=\"msg\" id=\"m-conv\"></div>\n    <div class=\"graf\" data-source=\"por_convtipo\"><canvas id=\"g-conv\"></canvas></div></div>\n  <div class=\"cartao\"><h2>Por caráter / clínica</h2><div class=\"msg\" id=\"m-carater\"></div>\n    <div class=\"graf alto\" data-source=\"por_carater\"><canvas id=\"g-carater\"></canvas></div></div>\n  <div class=\"cartao\"><h2>Pirâmide etária (faixa ANS × sexo)</h2><div class=\"msg\" id=\"m-pir\"></div>\n    <div class=\"graf alto\" data-source=\"piramide\"><canvas id=\"g-pir\"></canvas></div></div>\n  <div class=\"cartao larga\"><h2>Ranking de convênios</h2><div class=\"msg\" id=\"m-top\"></div>\n    <div class=\"tabwrap\"><table data-source=\"top_conv\" data-row-key=\"NO_CONVENIO\">\n      <thead><tr><th data-field=\"NO_CONVENIO\">Convênio</th><th data-field=\"MD_QT_TOTAL_ATENDIMENTO\">Atendimentos</th><th data-field=\"MD_QT_PACIENTE\">Pacientes</th><th data-field=\"MD_QT_MEDIA_DIAS_PERMANENCIA\">Permanência média (dias)</th></tr></thead>\n      <tbody id=\"t-top\"></tbody></table></div></div>\n</div>\n\n<script>\nweknow.calc('resumo', {\n  title: 'Atendimentos por paciente',\n  description: 'Total de atendimentos dividido pelo número de pacientes, nos filtros selecionados.',\n  inputs: ['kpis'],\n  fn: (kpis) => kpis.map((linha) => ({\n    ATEND_POR_PACIENTE: Number(linha.MD_QT_PACIENTE) ? Number(linha.MD_QT_TOTAL_ATENDIMENTO) / Number(linha.MD_QT_PACIENTE) : 0,\n  })),\n});\n\nweknow.calc('tipo_share', {\n  title: 'Participação por tipo de atendimento',\n  description: 'Atendimentos por tipo e a participação percentual de cada tipo no total filtrado.',\n  inputs: ['por_tipo'],\n  fn: (por_tipo) => {\n    const total = por_tipo.reduce((s, l) => s + (Number(l.MD_QT_TOTAL_ATENDIMENTO) || 0), 0);\n    return por_tipo.map((l) => ({\n      DS_TP_ATENDIMENTO: l.DS_TP_ATENDIMENTO,\n      MD_QT_TOTAL_ATENDIMENTO: Number(l.MD_QT_TOTAL_ATENDIMENTO) || 0,\n      PCT: total ? (100 * (Number(l.MD_QT_TOTAL_ATENDIMENTO) || 0)) / total : 0,\n    }));\n  },\n});\n\nconst loc = () => weknow.locale || 'pt-BR';\nconst n0 = (v) => Number(v).toLocaleString(loc(), { maximumFractionDigits: 0 });\nconst n1 = (v) => Number(v).toLocaleString(loc(), { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst n2 = (v) => Number(v).toLocaleString(loc(), { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst rot = (s) => (s == null ? '' : String(s)).trim() || '(não informado)';\nconst mes = (ym) => { const y = Math.floor(Number(ym) / 100), m = Number(ym) % 100;\n  return new Date(y, m - 1, 1).toLocaleDateString(loc(), { month: 'short', year: 'numeric' }); };\nconst cor = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();\nconst graficos = {};\n\nfunction estado(id, ds) {\n  const el = document.getElementById(id);\n  if (!el) return;\n  el.textContent = ds.status === 'empty' ? 'Sem dados para os filtros selecionados.'\n    : ds.status === 'error' ? 'Não foi possível carregar: ' + (ds.message || 'erro') : '';\n}\n\nfunction desenhar(id, cfg) {\n  const g = graficos[id];\n  if (g) { g.data = cfg.data; g.options = cfg.options; g.update('none'); }\n  else { graficos[id] = new Chart(document.getElementById(id), cfg); }\n}\n\nfunction opcoesBase(extra) {\n  const txt = cor('--suave'), grid = cor('--borda');\n  return Object.assign({ maintainAspectRatio: false, animation: false,\n    plugins: { legend: { labels: { color: cor('--texto') } } },\n    scales: { x: { ticks: { color: txt }, grid: { color: grid } }, y: { ticks: { color: txt }, grid: { color: grid } } } }, extra || {});\n}\n\nfunction chips(elId, ds, campo, pLista, pTodos, p) {\n  const el = document.getElementById(elId);\n  if (ds.status !== 'ok' && ds.status !== 'refreshing') { if (!ds.data.length) { el.textContent = ds.status === 'error' ? 'Erro ao carregar opções' : ''; return; } }\n  const todos = document.createElement('button');\n  todos.type = 'button'; todos.textContent = 'Todos';\n  todos.setAttribute('aria-pressed', String(!!p[pTodos]));\n  todos.onclick = () => weknow.setParams({ [pLista]: [], [pTodos]: true });\n  const botoes = ds.data.map((linha) => {\n    const valor = linha[campo] == null ? '' : linha[campo];\n    const b = document.createElement('button');\n    b.type = 'button'; b.textContent = rot(valor);\n    b.setAttribute('aria-pressed', String(!p[pTodos] && p[pLista].includes(valor)));\n    b.onclick = () => {\n      const atual = p[pTodos] ? [] : p[pLista];\n      const novas = atual.includes(valor) ? atual.filter((x) => x !== valor) : [...atual, valor];\n      weknow.setParams({ [pLista]: novas, [pTodos]: novas.length === 0 });\n    };\n    return b;\n  });\n  el.replaceChildren(todos, ...botoes);\n}\n\nfunction periodo(ds, p) {\n  const meses = ds.data.map((l) => Number(l.DT_ATENDIMENTO_yearMonth)).filter((v) => v >= 190001 && v <= 209912).sort((a, b) => a - b);\n  const ini = document.getElementById('ini'), fim = document.getElementById('fim');\n  if (!meses.length) { ini.replaceChildren(); fim.replaceChildren(); return; }\n  const faixa = p.periodo || [meses[0], meses[meses.length - 1]];\n  const vIni = meses.find((m) => m >= faixa[0]) || meses[0];\n  const vFim = [...meses].reverse().find((m) 